
/* ══════════════════════════════════════════════════════════════
   DIAGRAMS
   Inline SVG. Paths draw on scroll; dots travel the path via
   offset-path so the flow direction is legible, not decorative.
   ══════════════════════════════════════════════════════════════ */
.dgm{width:100%;height:auto;overflow:visible}
.dgm text{font-family:var(--mono);font-size:10px;letter-spacing:.1em;
  text-transform:uppercase;fill:var(--ink-faint);font-weight:700}
.dgm .lbl{font-family:var(--sans);font-size:12px;font-weight:700;letter-spacing:-.02em;
  fill:var(--ink);text-transform:none}
.dgm .sub{font-family:var(--sans);font-size:11px;font-weight:500;letter-spacing:0;
  fill:var(--ink-muted);text-transform:none}
.sec--ink .dgm .lbl{fill:var(--cloud-bg)}
.sec--ink .dgm .sub{fill:#cbd5e1}
.sec--ink .dgm text{fill:var(--ink-faint-dark)}
.dgm .node{fill:var(--surface);stroke:var(--border);stroke-width:1.2}
.sec--ink .dgm .node{fill:rgba(255,255,255,.05);stroke:rgba(255,255,255,.14)}
.dgm .node--lav{fill:var(--lavender-soft);stroke:#ddd6fe}
.dgm .node--el{fill:var(--electric-soft);stroke:#bfdbfe}
.dgm .node--gr{fill:var(--green-soft);stroke:#a7f3d0}
.dgm .wire{fill:none;stroke:var(--border);stroke-width:1.4;stroke-linecap:round}
.dgm .wire--live{stroke:var(--lavender);stroke-width:1.6;
  stroke-dasharray:5 7;animation:dashRun 1.1s linear infinite}
.dgm .flow{fill:var(--lavender-deep);r:3.4}
.dgm .flow--el{fill:var(--electric-deep)}
.dgm .ic{fill:none;stroke:var(--lavender-deep);stroke-width:1.5;stroke-linecap:round;
  stroke-linejoin:round}
.dgm .ic--el{stroke:var(--electric-deep)} .dgm .ic--gr{stroke:var(--green-deep)}

/* Travelling dots ride the wire via offset-path. They carry no cx/cy, so without
   offset-path support (Safari < 16) they would paint at 0,0 as stray dots — hence
   hidden by default and enabled only where the property actually works. */
.dgm .travel{display:none}
@supports (offset-path:path('M0 0')){
  @media (prefers-reduced-motion:no-preference){
    .dgm .travel{display:inline;offset-path:var(--p);
      animation:flowDot var(--dur,3.4s) var(--e-io) infinite;animation-delay:var(--dly,0s)}
  }
}
@media (prefers-reduced-motion:reduce){
  .dgm .wire--live{animation:none;stroke-dasharray:none}}

/* diagram frame */
.dgm-wrap{background:var(--surface);border:1px solid var(--border);border-radius:var(--r-lg);
  padding:var(--s6) var(--s5);box-shadow:var(--sh-2);position:relative;overflow:hidden}
.sec--ink .dgm-wrap{background:rgba(255,255,255,.04);border-color:rgba(255,255,255,.1);
  box-shadow:none}
.dgm-wrap__cap{display:flex;flex-wrap:wrap;gap:var(--s3);justify-content:space-between;
  align-items:baseline;margin-bottom:var(--s5)}

/* —— hash-chain strip —— */
.chain{display:flex;align-items:stretch;gap:0;overflow-x:auto;padding-bottom:var(--s2)}
.chain__b{flex:1 0 8.75rem;background:var(--surface);border:1px solid var(--border);
  border-radius:var(--r-md);padding:.875rem .75rem;position:relative;
  animation:chainPop var(--t4) var(--e-out) both}
.chain__b:nth-child(2){animation-delay:.1s} .chain__b:nth-child(3){animation-delay:.2s}
.chain__b:nth-child(4){animation-delay:.3s} .chain__b:nth-child(5){animation-delay:.4s}
.chain__b + .chain__b{margin-left:1.25rem}
.chain__b + .chain__b::before{content:"";position:absolute;left:-1.3rem;top:50%;width:1.3rem;
  height:1.5px;background:var(--lavender);opacity:.55}
.chain__b + .chain__b::after{content:"";position:absolute;left:-.5rem;top:calc(50% - 3px);
  width:6px;height:6px;border-radius:50%;background:var(--lavender)}
.chain__t,.chain__l,.chain__h{display:block}
.chain__t{font-family:var(--mono);font-size:.625rem;letter-spacing:.09em;color:var(--ink-faint);
  text-transform:uppercase;font-weight:700}
.chain__h{font-family:var(--mono);font-size:.625rem;color:var(--lavender-deep);margin-top:.375rem;
  word-break:break-all;line-height:1.5;font-weight:600}
.chain__l{font-size:.75rem;font-weight:600;margin-top:.375rem;letter-spacing:-.01em}
.sec--ink .chain__b{background:rgba(255,255,255,.05);border-color:rgba(255,255,255,.12)}
.sec--ink .chain__h{color:var(--lavender)}

/* —— comparison rail —— */
.rail{display:grid;gap:var(--s2)}
.rail__r{display:grid;grid-template-columns:8.5rem 1fr;gap:var(--s4);align-items:center;
  padding:.75rem 0;border-top:1px solid var(--border)}
.rail__r:first-child{border-top:0}
.sec--ink .rail__r{border-color:rgba(255,255,255,.1)}
.rail__k{font-family:var(--mono);font-size:.6875rem;letter-spacing:.11em;text-transform:uppercase;
  color:var(--ink-faint);font-weight:700}
.rail__bars{display:flex;gap:.375rem;align-items:center}
.rail__bar{height:.5rem;border-radius:var(--r-full);transform-origin:left;
  animation:barGrow 1s var(--e-out) both}
.rail__bar--lav{background:linear-gradient(90deg,var(--lavender-deep),var(--lavender))}
.rail__bar--el{background:linear-gradient(90deg,var(--electric-deep),var(--electric))}
.rail__bar--gr{background:linear-gradient(90deg,var(--green-deep),var(--green-success))}
.rail__v{font-size:.75rem;font-weight:700;color:var(--ink-muted);white-space:nowrap}

/* —— coverage matrix: use cases × capture modes —— */
.mx{overflow-x:auto;-webkit-overflow-scrolling:touch}
.mx table{width:100%;min-width:38rem;border-collapse:separate;border-spacing:0}
.mx th,.mx td{padding:.8125rem 1rem;text-align:center;border-bottom:1px solid var(--border);
  font-size:.8125rem}
.mx thead th{font-family:var(--mono);font-size:.625rem;letter-spacing:.12em;
  text-transform:uppercase;color:var(--ink-faint);font-weight:700;padding-bottom:.625rem;
  border-bottom:1px solid var(--border)}
.mx tbody th{text-align:left;font-weight:600;letter-spacing:-.015em;color:var(--ink);
  white-space:nowrap}
.mx tbody tr:last-child th,.mx tbody tr:last-child td{border-bottom:0}
.mx tbody tr{transition:background var(--t1)}
.mx tbody tr:hover{background:var(--mist)}
.mx .y{display:inline-grid;place-items:center;width:1.375rem;height:1.375rem;border-radius:50%;
  background:var(--green-soft);color:var(--green-deep);font-size:.6875rem;font-weight:800}
.mx .n{color:var(--ink-faint);font-weight:600}
.mx .p{display:inline-grid;place-items:center;width:1.375rem;height:1.375rem;border-radius:50%;
  background:var(--lavender-soft);color:var(--lavender-deep);font-size:.6875rem;font-weight:800}

/* —— session controls (trust) —— */
.ctrl{display:grid;gap:var(--s4);margin-top:var(--s10)}
@media(min-width:700px){.ctrl{grid-template-columns:repeat(2,1fr)}}
@media(min-width:1024px){.ctrl{grid-template-columns:repeat(4,1fr)}}
.ctrl__i{display:flex;gap:.875rem;align-items:flex-start;background:rgba(255,255,255,.045);
  border:1px solid rgba(255,255,255,.1);border-radius:var(--r-md);padding:var(--s5)}
.ctrl__ic{width:2.25rem;height:2.25rem;border-radius:.625rem;display:grid;place-items:center;
  flex:none;background:rgba(167,139,250,.14);color:var(--lavender)}
.ctrl__ic svg{width:1.125rem;height:1.125rem}
.ctrl__i b{font-size:.875rem;font-weight:700;letter-spacing:-.02em;display:block}
.ctrl__i p{font-size:.78125rem;line-height:1.6;color:#cbd5e1;margin-top:.25rem}

/* —— demo split —— */
.demo__g{display:grid;gap:var(--s8);align-items:stretch;margin-top:var(--s10);text-align:left}
@media(min-width:900px){.demo__g{grid-template-columns:1fr 28rem;gap:var(--s12)}}
.see{display:flex;flex-direction:column;gap:.75rem}
.see__i{flex:1;align-items:center}
.see__i{display:flex;gap:.75rem;align-items:flex-start;background:rgba(255,255,255,.05);
  border:1px solid rgba(255,255,255,.11);border-radius:var(--r-md);padding:1rem 1.125rem}
.see__n{font-family:var(--mono);font-size:.625rem;font-weight:700;color:var(--lavender);
  letter-spacing:.1em;flex:none;padding-top:.125rem}
.see__i b{font-size:.9375rem;font-weight:700;letter-spacing:-.02em;display:block;color:var(--cloud-bg)}
.see__i p{font-size:.8125rem;line-height:1.6;color:#cbd5e1;margin-top:.1875rem}
.chain__lg{display:flex;flex-wrap:wrap;gap:.5625rem;margin-top:var(--s5)}
