<!-- ══════════ TRUST ══════════ -->
<section class="sec sec--ink" id="trust" aria-labelledby="h-tr">
  <div class="grid-bg"></div>
  <div class="blob" style="width:32rem;height:32rem;top:-12rem;right:-9rem;
    background:rgba(96,165,250,.28)"></div>
  <div class="wrap">
    <div class="shead shead--split">
      <div>
        <span class="eyebrow" data-rise>Why banks trust us</span>
        <h2 class="display" id="h-tr" data-rise data-delay="1">Built by a regulated entity.<br>Audited continuously.</h2>
      </div>
      <p class="lede" data-rise data-delay="2">Jaano runs on Blostem&rsquo;s production stack.
        Blostem is an RBI-compliant Technical Service Provider already live with the banks and
        NBFCs below &mdash; Jaano inherits that same infrastructure, certification and control set.</p>
    </div>

    <div style="margin-top:var(--s10)" data-rise data-delay="1">
      <span class="tiny">Blostem is live with</span>
      <div class="prow" style="margin-top:.875rem">
        <span class="pill">Shivalik SFB</span><span class="pill">Suryoday SFB</span>
        <span class="pill">Unity SFB</span><span class="pill">Utkarsh SFB</span>
        <span class="pill">IndusInd Bank</span><span class="pill">Bajaj Finance</span>
      </div>
      <p class="body" style="margin-top:var(--s4);max-width:44rem;color:#8d9ab2;
        font-size:.8125rem">These are Blostem platform relationships, not Jaano
        deployments. They are listed to show the infrastructure, controls and regulatory
        posture Jaano is built on.</p>
    </div>

    <div class="g g--4" style="grid-template-columns:repeat(auto-fit,minmax(11rem,1fr))"
      data-rise data-delay="2">
      <div class="cert"><span>Certification</span><b>ISO 27001:2022</b></div>
      <div class="cert"><span>Regulation</span><b>RBI V-CIP</b></div>
      <div class="cert"><span>Privacy</span><b>DPDP Act aligned</b></div>
      <div class="cert"><span>Residency</span><b>100% India &middot; DR</b></div>
      <div class="cert"><span>Security</span><b>CERT-In annual VAPT</b></div>
    </div>

    <div class="ctrl" data-rise data-delay="3">
      <div class="ctrl__i"><span class="ctrl__ic"><svg viewBox="0 0 24 24" fill="none">
        <circle cx="12" cy="12" r="8.4" stroke="currentColor" stroke-width="1.7"/>
        <circle cx="12" cy="12" r="3.2" fill="currentColor"/></svg></span>
        <span><b>Recording built in</b><p>Every session can be recorded &mdash; evidence without extra tooling.</p></span></div>
      <div class="ctrl__i"><span class="ctrl__ic"><svg viewBox="0 0 24 24" fill="none">
        <path d="M5 12.5l4.2 4.2L19 7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
        <span><b>Consent on record</b><p>Captured on camera before anything else is &mdash; part of the case itself.</p></span></div>
      <div class="ctrl__i"><span class="ctrl__ic"><svg viewBox="0 0 24 24" fill="none">
        <rect x="3.5" y="4" width="7" height="7" rx="2" stroke="currentColor" stroke-width="1.7"/>
        <rect x="13.5" y="13" width="7" height="7" rx="2" stroke="currentColor" stroke-width="1.7"/>
        <path d="M10.5 7.5h4a2 2 0 0 1 2 2V13" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg></span>
        <span><b>Hash-chained audit</b><p>Every event linked to the one before it. Edits break the chain, visibly.</p></span></div>
      <div class="ctrl__i"><span class="ctrl__ic"><svg viewBox="0 0 24 24" fill="none">
        <circle cx="9" cy="8" r="3.2" stroke="currentColor" stroke-width="1.7"/>
        <circle cx="16.5" cy="9.5" r="2.4" stroke="currentColor" stroke-width="1.7"/>
        <path d="M3.5 19v-1.2A5.3 5.3 0 0 1 8.8 12.5h.4a5.3 5.3 0 0 1 4.4 2.3M14.6 19v-.8a4 4 0 0 1 4-4h.4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg></span>
        <span><b>Maker&ndash;checker, 100%</b><p>Two people on every case, anti-collusion enforced. No sampling.</p></span></div>
    </div>
  </div>
</section>

<!-- ══════════ DEMO + LEAD FORM ══════════ -->
<section class="sec sec--ink" id="demo" aria-labelledby="h-demo" style="background:var(--ink-dark)">
  <div class="blob" style="width:25rem;height:25rem;bottom:-8rem;left:-6rem;
    background:var(--lavender);opacity:.25"></div>
  <div class="blob" style="width:25rem;height:25rem;top:-8rem;right:-6.25rem;
    background:var(--electric);opacity:.22;animation-delay:-8s"></div>
  <div class="wrap" style="max-width:64rem;text-align:center">
    <h2 class="display" id="h-demo" data-rise
      style="font-size:clamp(2.25rem,4.8vw,3.75rem);line-height:1.05">
      Verify <span style="color:var(--lavender)">anything</span>.<br>
      Prove <span style="color:var(--electric)">everything</span>.</h2>
    <p class="lede" data-rise data-delay="1" style="margin:var(--s6) auto 0;max-width:42rem">
      30 minutes. We&rsquo;ll show you a live session, the auditor console, and a sandbox URL you
      can call from your laptop today &mdash; and configure a new use case in front of you.</p>

    
    <div class="demo__g">
      <div class="see" data-rise data-delay="2">
        <div class="see__i"><span class="see__n">01</span>
          <span><b>A live verification session</b>
          <p>Watch a real capture &mdash; liveness, geo-lock and signals as they happen.</p></span></div>
        <div class="see__i"><span class="see__n">02</span>
          <span><b>The auditor console</b>
          <p>The maker&ndash;checker view your reviewers would use, case by case.</p></span></div>
        <div class="see__i"><span class="see__n">03</span>
          <span><b>A sandbox URL you can call today</b>
          <p>From your laptop, during the call &mdash; one POST, one webhook.</p></span></div>
        <div class="see__i"><span class="see__n">04</span>
          <span><b>Your use case, configured live</b>
          <p>Tell us what you verify &mdash; we&rsquo;ll build the checklist in front of you.</p></span></div>
      </div>
      <form id="lead-form" novalidate
      data-rise data-delay="3" style="max-width:none;border-radius:var(--r-lg);
      padding:var(--s6);text-align:left;background:var(--cloud-bg);color:var(--ink);
      box-shadow:var(--sh-ink)">
      <div class="eyebrow" style="color:var(--lavender-deep)">Request a demo</div>
      <div style="margin-top:var(--s4);display:grid;gap:.75rem">
        <label class="sr-only" for="f-name">Full name</label>
        <input class="fld" id="f-name" name="name" required placeholder="Full name" autocomplete="name">
        <label class="sr-only" for="f-email">Work email</label>
        <input class="fld" id="f-email" name="email" type="email" required placeholder="Work email" autocomplete="email">
        <label class="sr-only" for="f-company">Company</label>
        <input class="fld" id="f-company" name="company" required placeholder="Company" autocomplete="organization">
        <label class="sr-only" for="f-phone">Phone (optional)</label>
        <input class="fld" id="f-phone" name="phone" type="tel" placeholder="Phone (optional)" autocomplete="tel">
        <label class="sr-only" for="f-msg">What do you want to verify?</label>
        <textarea class="fld" id="f-msg" name="message" rows="2"
          placeholder="What do you want to verify? (optional)"></textarea>
        <input type="text" name="website" tabindex="-1" autocomplete="off"
          aria-hidden="true" class="hp">
      </div>
      <button type="submit" class="btn btn--primary" style="margin-top:var(--s4);width:100%">
        Request a demo &rarr;</button>
      <p id="lead-status" role="status" style="display:none;margin-top:.75rem;font-size:.875rem"></p>
      <p style="margin-top:.75rem;font-size:.78125rem;color:var(--ink-muted);
        font-weight:500">We reply within one business day.</p>
    </form>
    </div>
  </div>
</section>

</main>

